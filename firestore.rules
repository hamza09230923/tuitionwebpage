rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isTeacher() {
      return signedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function isStaff() {
      return isAdmin() || isTeacher();
    }

    // A tutor may only see a student where an admin has created this
    // membership document: teachers/{tutorId}/students/{studentId}.
    function isAssignedTutor(studentId) {
      return isTeacher() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)/students/$(studentId));
    }

    // A class document contains tutorIds and studentIds arrays.  Keeping the
    // membership check here makes the same permission apply to homework,
    // videos, resources and submitted work.
    function isClassTutor(classId) {
      return isTeacher() &&
        request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.tutorIds;
    }

    function isClassStudent(classId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.studentIds;
    }

    function isClassMember(classId) {
      return isAdmin() || isClassTutor(classId) || isClassStudent(classId);
    }

    function isOwnStudent(uid) {
      return signedIn() &&
        request.auth.uid == uid &&
        exists(/databases/$(database)/documents/students/$(uid));
    }

    function studentSubjects() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data.subjects;
    }

    function isEnrolledIn(subjectId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        subjectId in studentSubjects();
    }

    // Every material carries its academic route. This makes Foundation/Higher
    // separation enforceable before a student can read its metadata or obtain
    // a private R2 download URL.
    function matchesMaterialRoute(material) {
      return get(/databases/$(database)/documents/students/$(request.auth.uid))
        .data.subjectSettings[material.subjectId].examBoard == material.examBoard && (
        material.tier == 'all-levels' ||
        get(/databases/$(database)/documents/students/$(request.auth.uid))
          .data.subjectSettings[material.subjectId].tier == material.tier
      );
    }

    function recordingIsVisible(recordingId) {
      return !('hiddenRecordingIds' in get(/databases/$(database)/documents/students/$(request.auth.uid)).data) ||
        !(recordingId in get(/databases/$(database)/documents/students/$(request.auth.uid)).data.hiddenRecordingIds);
    }

    function homeworkIsVisible(homeworkId) {
      return !('hiddenHomeworkIds' in get(/databases/$(database)/documents/students/$(request.auth.uid)).data) ||
        !(homeworkId in get(/databases/$(database)/documents/students/$(request.auth.uid)).data.hiddenHomeworkIds);
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /teachers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /students/{uid} {
      allow read: if isOwnStudent(uid) || isAdmin() || isAssignedTutor(uid);
      allow write: if isAdmin();
    }

    // Admins create classes and enrol tutors and students.  Tutors can only
    // access the classes in which their UID appears in tutorIds.
    match /classes/{classId} {
      allow read: if isClassMember(classId);
      allow create, update, delete: if isAdmin();

      match /students/{studentId} {
        allow read: if isClassTutor(classId) ||
          (signedIn() && request.auth.uid == studentId && isClassStudent(classId));
        allow write: if isAdmin();
      }
    }

    // Metadata only: the R2 key is never a public URL. The R2 access service
    // checks the same class membership before issuing any upload or download.
    match /classMaterials/{materialId} {
      allow read: if isClassMember(resource.data.classId);
      allow create, update, delete: if isAdmin();
    }

    match /classSubmissions/{submissionId} {
      allow read: if isClassTutor(resource.data.classId) ||
        (signedIn() && resource.data.studentId == request.auth.uid && isClassStudent(resource.data.classId));
      allow create: if (signedIn() && request.resource.data.studentId == request.auth.uid &&
          isClassStudent(request.resource.data.classId)) ||
        isClassTutor(request.resource.data.classId);
      allow update: if isClassTutor(resource.data.classId) ||
        (signedIn() && resource.data.studentId == request.auth.uid && isClassStudent(resource.data.classId));
      allow delete: if isClassTutor(resource.data.classId) || isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isStaff() || isEnrolledIn(subjectId);
      allow write: if isStaff();
    }

    match /recordings/{recordingId} {
      allow read: if isStaff() || (
        isEnrolledIn(resource.data.subjectId) &&
        (
          !('approvalStatus' in resource.data) ||
          resource.data.approvalStatus == 'approved'
        ) && matchesMaterialRoute(resource.data) && recordingIsVisible(recordingId)
      );
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /studentRecordings/{recordingId} {
      allow read: if isStaff() || (
        signedIn() &&
        resource.data.studentId == request.auth.uid &&
        isEnrolledIn(resource.data.subjectId) &&
        (
          !('approvalStatus' in resource.data) ||
          resource.data.approvalStatus == 'approved'
        ) && matchesMaterialRoute(resource.data) && recordingIsVisible(recordingId)
      );
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /homeworks/{homeworkId} {
      allow read: if isStaff() || (isEnrolledIn(resource.data.subjectId) && matchesMaterialRoute(resource.data) && homeworkIsVisible(homeworkId));
      allow create, update, delete: if isAdmin();
    }

    match /studentHomeworks/{homeworkId} {
      allow read: if isStaff() || (
        signedIn() &&
        resource.data.studentId == request.auth.uid &&
        isEnrolledIn(resource.data.subjectId) && matchesMaterialRoute(resource.data) && homeworkIsVisible(homeworkId)
      );
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if isStaff() || (
        isEnrolledIn(resource.data.subjectId) &&
        (
          !('approvalStatus' in resource.data) ||
          resource.data.approvalStatus == 'approved'
        ) && matchesMaterialRoute(resource.data)
      );
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /studentResources/{resourceId} {
      allow read: if isStaff() || (
        signedIn() &&
        resource.data.studentId == request.auth.uid &&
        isEnrolledIn(resource.data.subjectId) &&
        (
          !('approvalStatus' in resource.data) ||
          resource.data.approvalStatus == 'approved'
        ) && matchesMaterialRoute(resource.data)
      );
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /webinarRegistrations/{registrationId} {
      allow read, write: if isAdmin();
    }

    match /submissions/{submissionId} {
      // Students can read only their own submissions
      allow read: if signedIn() && resource.data.studentId == request.auth.uid;
      // Students can create submissions for themselves only
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      // Students can update their own submission (to change link)
      allow update: if signedIn() && resource.data.studentId == request.auth.uid;
      // Only staff can read all submissions
      allow read: if isStaff();
      // Only staff can update (mark as marked) and delete
      allow update: if isStaff();
      allow delete: if isStaff();
    }
  }
}
